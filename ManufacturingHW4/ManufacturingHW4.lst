Equation Listing    SOLVE DELIVERING Using LP From line 90


---- COST  =E=  Total cost ($) and objective function value

COST..  - 5*X(Arnold,Thomas) - 8*X(Arnold,Wash-Burn) - 7*X(Supershelf,Thomas) - 4*X(Supershelf,Wash-Burn) - Y(Thomas,Zrox) - 5*Y(Thomas,Hewes) - 8*Y(Thomas,Rock-Wright) - 3*Y(Wash-Burn,Zrox) - 4*Y(Wash-Burn,Hewes) - 4*Y(Wash-Burn,Rock-Wright) + VCOST =E= 0 ; (LHS = 0)
     

---- MAN_CONSTRAIN  =L=  Constraints on manufacturing supplies

MAN_CONSTRAIN(Arnold)..  X(Arnold,Thomas) + X(Arnold,Wash-Burn) =L= 75 ; (LHS = 0)
     
MAN_CONSTRAIN(Supershelf)..  X(Supershelf,Thomas) + X(Supershelf,Wash-Burn) =L= 75 ; (LHS = 0)
     

---- SUP_CONSTRAIN  =G=  Constraints on what suppliers are able to ship to recipients

SUP_CONSTRAIN(Thomas)..  X(Arnold,Thomas) + X(Supershelf,Thomas) - Y(Thomas,Zrox) - Y(Thomas,Hewes) - Y(Thomas,Rock-Wright) =G= 0 ; (LHS = 0)
     
SUP_CONSTRAIN(Wash-Burn)..  X(Arnold,Wash-Burn) + X(Supershelf,Wash-Burn) - Y(Wash-Burn,Zrox) - Y(Wash-Burn,Hewes) - Y(Wash-Burn,Rock-Wright) =G= 0 ; (LHS = 0)
     

---- RECIP_CONSTRAIN  =G=  Constraints on minimum shelves that need to be delivered to recipients

RECIP_CONSTRAIN(Zrox)..  Y(Thomas,Zrox) + Y(Wash-Burn,Zrox) =G= 50 ; (LHS = 0, INFES = 50 ****)
     
RECIP_CONSTRAIN(Hewes)..  Y(Thomas,Hewes) + Y(Wash-Burn,Hewes) =G= 60 ; (LHS = 0, INFES = 60 ****)
     
RECIP_CONSTRAIN(Rock-Wright)..  Y(Thomas,Rock-Wright) + Y(Wash-Burn,Rock-Wright) =G= 40 ; (LHS = 0, INFES = 40 ****)
     
