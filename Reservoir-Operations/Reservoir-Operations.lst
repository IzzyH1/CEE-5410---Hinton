PROFIT..  - 150*X(June,diversion) - 170*X(July,diversion) - 425*X(August,diversion) + VPROFIT =E= 0 ; (LHS = 0)
     

---- MAX_STORAGE  =L=  Resource Constraints

MAX_STORAGE(June)..  X(June,reservoir) =L= 9000 ; (LHS = 0)
     
MAX_STORAGE(July)..  X(July,reservoir) =L= 9000 ; (LHS = 0)
     
MAX_STORAGE(August)..  X(August,reservoir) =L= 9000 ; (LHS = 0)
     

---- MIN_STORAGE  =G=  minimum storage constraint for august

MIN_STORAGE..  X(August,reservoir) =G= 3000 ; (LHS = 0, INFES = 3000 ****)
     

---- MASS_BALANCE  =E=  

MASS_BALANCE(June)..  X(June,reservoir) + X(June,spill) + X(June,diversion) =E= 8000 ; (LHS = 0, INFES = 8000 ****)
     
MASS_BALANCE(July)..  - X(June,reservoir) + X(July,reservoir) + X(July,spill) + X(July,diversion) =E= 3200 ; (LHS = 0, INFES = 3200 ****)
     
MASS_BALANCE(August)..  - X(July,reservoir) + X(August,reservoir) + X(August,spill) + X(August,diversion) =E= 2000 ; (LHS = 0, INFES = 2000 ****)
     
